{
  "name": "crashpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/vendor-ocr.mjs && concurrently -p none \"serwist build serwist.config.mjs --watch\" \"next dev\"",
    "dev:once": "node scripts/vendor-ocr.mjs && serwist build serwist.config.mjs && next dev",
    "build": "node scripts/vendor-ocr.mjs && next build && serwist build serwist.config.mjs && npm run check:storage && npm run check:media && npm run check:nav && npm run check:pdf && npm run check:collision-edit && npm run check:locate && npm run check:license-scan",
    "start": "next start",
    "lint": "eslint",
    "check:storage": "node scripts/storage-check.mjs",
    "check:media": "node --experimental-strip-types scripts/media-check.mjs",
    "check:nav": "node --experimental-strip-types scripts/nav-check.mjs",
    "check:pdf": "node --experimental-strip-types scripts/pdf-check.mjs",
    "check:collision-edit": "node --experimental-strip-types scripts/collision-edit-check.mjs",
    "check:locate": "node --experimental-strip-types scripts/locate-check.mjs",
    "check:license-scan": "esbuild scripts/license-scan-check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/license-scan-check.mjs && node node_modules/.cache/license-scan-check.mjs"
  },
  "dependencies": {
    "@llamaindex/liteparse-wasm": "^2.15.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "validator": "^13.15.35",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/validator": "^13.15.10",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
